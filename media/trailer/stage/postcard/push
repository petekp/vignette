#!/bin/sh
# Shows an image in Vignette as Claude's, with Claude's marks on it: ./push <image.png> <marks.json>
# The card names this Claude Code session, so a drawing sent back from it replies here.
set -e
image="${1:?usage: ./push <image.png> <marks.json>}"
marks="${2:?usage: ./push <image.png> <marks.json>}"
encode() {
  case "$1" in /*) path="$1" ;; *) path="$PWD/$1" ;; esac
  osascript -l JavaScript -e 'function run(argv) { return encodeURIComponent(argv[0]) }' "$path"
}
# -a sends the URL to that copy of the app: without it, macOS picks whichever copy of the bundle id
# it registered last.
open -g ${VIGNETTE_APP:+-a "$VIGNETTE_APP"} "${VIGNETTE_SCHEME:-vignette}://add?file=$(encode "$image")&marks=$(encode "$marks")&agent=claude&session=${CLAUDE_CODE_SESSION_ID:-}"
echo "pushed $image to Vignette"
