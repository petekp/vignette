#!/bin/sh
# Answers a Vignette screenshot request with a drawing. The Vignette that sent the request does the
# work: the ticket names that app, and its binary runs as `<binary> reply <these arguments>`.
#
# Agents given version 3 of the skill run this file with python3. Python reads the next line as the
# start of a string that ends above the Python lines at the bottom, which run the file with sh; sh
# reads it as `:`, which does nothing.
''':'

usage() {
  cat <<'USAGE'
usage: reply --ticket <ticket.json> --marks <marks.json> [--image <your image>]
       reply --ticket <ticket.json> --retry <bundle folder>

The ticket is the ticket.json beside the image Vignette sent you. Given one, --help also
describes the marks and the exit codes.
USAGE
  exit 0
}

fail() {
  printf '{"status": "error", "error": "%s"}\n' "$1"
  exit 1
}

# The ticket, found the way the command's Options finds it: a flag written without `=` takes the
# next argument as its value, whatever that looks like.
ticket= wanted= help=
for argument in "$@"; do
  if [ -n "$wanted" ]; then
    [ "$wanted" = --ticket ] && ticket=$argument
    wanted=
    continue
  fi
  case $argument in
    -h|--help) help=1 ;;
    --ticket=*) ticket=${argument#--ticket=} ;;
    --ticket|--marks|--image|--retry) wanted=$argument ;;
  esac
done

if [ -z "$ticket" ]; then
  [ -n "$help" ] && usage
  fail "--ticket is required: the ticket.json in the same folder as the image you were sent"
fi
[ -f "$ticket" ] && [ ! -L "$ticket" ] && [ -r "$ticket" ] ||
  fail "cannot read the ticket; it is the ticket.json in the same folder as the image you were sent"

app=$(plutil -extract app raw -o - "$ticket" 2>/dev/null) || fail "the ticket names no app"
info=$app/Contents/Info.plist
[ -f "$info" ] ||
  fail "the Vignette that sent this request is no longer where it was; ask the user to send the drawing again"
# A binary without the reply command would start the app and replace the running instance.
[ "$(plutil -extract VignetteReplyCommand raw -o - "$info" 2>/dev/null)" = true ] ||
  fail "the Vignette that sent this request is older than this skill; ask the user to update Vignette, then run this again"

# Only a ticket where Vignette writes them names the app to run, in
# ~/Library/Application Support/<that app's bundle id>/requests/<request id>/ticket.json.
# Anything that can put a file there can already run code as the user.
[ -n "$HOME" ] || fail "HOME is not set, so the ticket's folder cannot be checked"
request=$(plutil -extract requestId raw -o - "$ticket" 2>/dev/null)
bundle=$(plutil -extract CFBundleIdentifier raw -o - "$info" 2>/dev/null)
name=$(plutil -extract CFBundleExecutable raw -o - "$info" 2>/dev/null)
folder=$(cd "$(dirname "$ticket")" 2>/dev/null && pwd -P)
support=$(cd "$HOME/Library/Application Support" 2>/dev/null && pwd -P)
[ -n "$request" ] && [ -n "$bundle" ] && [ -n "$folder" ] && [ -n "$support" ] &&
  [ "$(basename "$ticket")" = ticket.json ] &&
  [ "$(basename "$folder")" = "$request" ] &&
  [ "$(basename "$(dirname "$folder")")" = requests ] &&
  [ "$(dirname "$(dirname "$folder")")" = "$support/$bundle" ] ||
  fail "this is not a ticket Vignette wrote; the ticket is the ticket.json beside the image Vignette sent"

case $name in ''|*/*) fail "the Vignette that sent this request names no binary; ask the user to reinstall Vignette" ;; esac
binary=$app/Contents/MacOS/$name
[ -f "$binary" ] && [ -x "$binary" ] ||
  fail "the Vignette that sent this request is no longer where it was; ask the user to send the drawing again"

"$binary" reply "$@"
code=$?
# 126 and 127 are the shell's own: the binary could not be run, so nothing was sent.
case $code in 126|127) fail "the Vignette that sent this request could not be run; ask the user to reinstall Vignette" ;; esac
exit "$code"
'''
import os, sys
os.execv("/bin/sh", ["/bin/sh", __file__] + sys.argv[1:])
